.+:|Otherwise.*:|For every .+:|Make a recipe called .+:)/im.test(src)||/(Call the result|Make sure|Show a warning|Open all (FASTQ|FASTA|CSV|TSV) files|\.microbiology|bacterial genome|bacterial reads|resistance genes|virulence genes|plasmids|identify the organism)/i.test(src)||((window.FigureLoomBioCurrentFile?.normalizeSource?.(src)||src)!==src)||(window.FigureLoomBioStatementRecognizers||[]).some(recognizer=>{try{return recognizer(src)}catch{return false}})||/\.flbio$/i.test(document.getElementById('programName')?.value||'')}
const CORE=window.FigureLoomBioCoreLanguageLoading=window.FigureLoomBioCoreLanguageLoading||fetch('./ide-core-language-runtime.js?v=1',{cache:'no-store'}).then(response=>{if(!response.ok)throw new Error(`Could not load the core language (${response.status})`);return typeof response.text==='function'?response.text():''}).then(source=>{if(!source)return null;let script=document.createElement('script');script.textContent=source;document.head.append(script);return window.FigureLoomBioCoreLanguageRuntime});
async function run(){R.replaceChildren();status('Running','running');B.disabled=1;let c={files:files(),data:null,named:new Map,cols:new Map,review:new Set,flags:{},sample:null,changed:0};try{await CORE;let source=window.FigureLoomBioCurrentFile?.normalizeSource?.(E.value)||E.value;let repeat=source.match(/^\s*Run this program ([1-9][0-9]*) times?\.\s*(?:\r?\n|$)/i),total=repeat?Number(repeat[1]):1;if(total>100)throw new X('Run a program at most 100 times at once.');if(repeat)source=source.slice(repeat[0].length);if(!source.trim())throw new X('Add at least one instruction after the repeat sentence.');for(let runNumber=1;runNumber<=total;runNumber++){c={files:files(),data:null,named:new Map,cols:new Map,review:new Set,flags:{},sample:null,changed:0};if(total>1)sec(`Run ${runNumber} of ${total}`);let p=parse(source);await nodes(p.b,c,p);if(c.review.size)sec('Review list',{table:{c:['sample'],r:[...c.review].map(sample=>({sample}))}});saveFiles(c.files)}localStorage.setItem(AK,document.getElementById('programName')?.value||'example.flbio');status(total>1?`Finished ${total} runs`:'Finished');if(c.changed)setTimeout(()=>location.reload(),100)}catch(e){if(e instanceof Stop){saveFiles(c.files);sec('Program stopped',{p:['The program followed a Stop instruction.']});status('Stopped')}else if(e instanceof Next)err(new X('Continue with the next sample and Skip this sample must be inside a sample loop.'));else if(e instanceof X)err(e);else{console.error(e);err(new X('Something unexpected stopped the program.'))}}finally{B.disabled=0;persist()}}
window.addEventListener('click',e=>{let t=e.target instanceof Element?e.target.closest('#runButton'):null;if(!t||!use(E.value))return;e.preventDefault();e.stopImmediatePropagation();run()},true);document.addEventListener('keydown',e=>{if(!(e.ctrlKey||e.metaKey)||e.key!=='Enter'||!use(E.value))return;e.preventDefault();e.stopImmediatePropagation();run()},true);window.FigureLoomBioStatementHandlers=window.FigureLoomBioStatementHandlers||[];window.FigureLoomBioStatementRecognizers=window.FigureLoomBioStatementRecognizers||[];window.FigureLoomBioFlow={parseProgram:parse,usesAdvancedRuntime:use,conditionValue:cond,registerStatementHandler(handler,recognizer){if(typeof handler==='function'&&!window.FigureLoomBioStatementHandlers.includes(handler))window.FigureLoomBioStatementHandlers.push(handler);if(typeof recognizer==='function'&&!window.FigureLoomBioStatementRecognizers.includes(recognizer))window.FigureLoomBioStatementRecognizers.push(recognizer)}};})();